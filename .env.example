# ==============================================================================
# AI Trader — Master Environment Configuration Template (.env.example)
# Copy to .env.research, .env.paper, or .env.live and customize as needed.
# ==============================================================================

# Target Environment: research | paper | live | test
AI_TRADER_ENVIRONMENT=test
AI_TRADER_VERSION=0.1.0
AI_TRADER_LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# PostgreSQL / TimescaleDB Configuration
# ------------------------------------------------------------------------------
AI_TRADER_DB_HOST=localhost
AI_TRADER_DB_PORT=5432
AI_TRADER_DB_USER=postgres
AI_TRADER_DB_PASSWORD=postgres_secure_password
AI_TRADER_DB_NAME=ai_trader
AI_TRADER_DB_POOL_SIZE=10
AI_TRADER_DB_SSL_MODE=prefer

# ------------------------------------------------------------------------------
# Risk Limits (RTLD §14 / BRD BR-1, BR-4)
# ------------------------------------------------------------------------------
AI_TRADER_RISK_MAX_DAILY_LOSS_PCT=0.02
AI_TRADER_RISK_MAX_DRAWDOWN_PCT=0.05
AI_TRADER_RISK_MAX_POSITION_SIZE_PCT=0.05
AI_TRADER_RISK_MAX_EXPOSURE_PCT=0.50
AI_TRADER_RISK_MAX_CONSECUTIVE_LOSSES=3
AI_TRADER_RISK_INITIAL_CAPITAL_INR=10000.0

# ------------------------------------------------------------------------------
# Broker Configuration (Zerodha / Shoonya)
# ------------------------------------------------------------------------------
AI_TRADER_BROKER_NAME=zerodha
AI_TRADER_BROKER_API_KEY=mock_key
AI_TRADER_BROKER_API_SECRET=mock_secret
AI_TRADER_BROKER_PAPER_TRADING=true
AI_TRADER_BROKER_RECONNECTION_WINDOW_S=30
